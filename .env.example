# WAJIB — Database MySQL

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=db_wa_blast

# WAJIB — Keamanan login dan akun admin
JWT_SECRET=buat_string_random_minimal_32_karakter_disini
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=ganti_password_minimal_12_karakter

# WAJIB — Salin dari manifest lisensi di dashboard member NgertiKode.id
# Tanpa LICENSE_KEY + LICENSE_API_SECRET, server menampilkan "LISENSI BELUM AKTIF".

LICENSE_KEY=
LICENSE_API_SECRET=
LICENSE_OWNER=
LICENSE_EMAIL=
LICENSE_ORDER_ID=
LICENSE_API_URL=https://api.ngertikode.id
# Public key resmi untuk memverifikasi respons server lisensi
LICENSE_RESPONSE_SIGNING_PUBLIC_KEY=
LICENSE_SIGNATURE_MAX_AGE_SECONDS=300
# Pemindahan perangkat dilakukan dari dashboard member
LICENSE_PUBLIC_RESET_ENABLED=false

# Build production opsional dengan URL dan public key tetap:
# go build -ldflags "-X wa-assistant/backend/license.PinnedLicenseAPIURL=https://api.ngertikode.id -X wa-assistant/backend/license.PinnedLicenseSigningPublicKey=BASE64_PUBLIC_KEY"

# OPSIONAL — Server dan batas penggunaan

PORT=3030
DB_PATH=./wa-assistant.db
CORS_ALLOWED_ORIGINS=*
TOKEN_TTL_HOURS=24
LOGIN_WINDOW_MIN=10
LOGIN_LOCK_MIN=10
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
MEDIA_RETENTION_DAYS=30
WA_MEDIA_MAX_MB=16
API_RATE_PER_MIN=60
API_RATE_BURST=20

# OPSIONAL — AI. Pengaturan utama dapat diisi dari dashboard
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# OPSIONAL — Cek ongkir (Mengantar API — lebih lengkap: ada booking + tracking + auto-resi)
MENGANTAR_API_KEY=
# OPSIONAL — Cek ongkir via RajaOngkir (fallback)
RAJAONGKIR_API_KEY=

# OPSIONAL — DeepSeek Direct (lebih murah, tanpa perantara OpenRouter)
DEEPSEEK_API_KEY=
